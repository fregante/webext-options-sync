{
	"name": "webext-options-sync",
	"version": "4.4.0-0",
	"description": "Helps you manage and autosave your extension's options.",
	"license": "MIT",
	"repository": "fregante/webext-options-sync",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./distribution/index.d.ts",
		"default": "./distribution/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc",
		"prepack": "tsc",
		"test": "npm run build && run-p ava xo",
		"watch": "tsc --watch",
		"ava": "ava",
		"xo": "xo"
	},
	"files": [
		"distribution"
	],
	"keywords": [
		"browser",
		"chrome",
		"extension",
		"firefox",
		"options",
		"sync",
		"webext"
	],
	"dependencies": {
		"@fregante/dom-form-serializer": "^2.1.0-0",
		"lz-string": "^1.5.0",
		"throttle-debounce": "^5.0.2",
		"uint8array-extras": "^1.6.0",
		"webext-detect": "^6.0.0",
		"webext-events": "^3.1.1",
		"webext-polyfill-kinda": "^1.0.2"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"@types/lz-string": "^1.5.0",
		"@types/throttle-debounce": "^5.0.2",
		"@types/wicg-file-system-access": "^2023.10.7",
		"ava": "^8.1.0",
		"globals": "^17.13.0",
		"npm-run-all": "^4.1.5",
		"sinon": "^22.1.0",
		"sinon-chrome": "^3.0.1",
		"type-fest": "^5.10.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"require": [
			"./test/_env.js"
		]
	}
}
